# Copy to .env (gitignored) and fill in real values before running the suite.
# These are dedicated, clearly-labelled TEST accounts on the live Moodle
# instance backing console.kostacademy.com / exam.kostacademy.com — never
# real candidate/staff credentials. See docs/PLATFORM_READINESS_REPORT.md
# Gate C for how each account/role was provisioned.

# kost_console_admin_role @ system context, in the console's authorized
# external-service user list (mdl_external_services_users).
RBAC_ADMIN_USER=rbac_test_admin
RBAC_ADMIN_PASS=""

# kost_console_auditor_role @ system context (pre-existing account; password
# rotated to a known test value via admin/cli/reset_password.php).
RBAC_AUDITOR_USER=console_auditor
RBAC_AUDITOR_PASS=""

# Moodle 'student' role, enrolled in course 4 (KOST-PRACTICE-TEST). Must be
# REFUSED console login by design (candidates cannot sign in to the console).
RBAC_CANDIDATE_USER=test_candidate
RBAC_CANDIDATE_PASS=""

# Moodle 'manager' role @ system context — proxy probe for the console's
# stated "exam manager" tier. As of 2026-08-25 this role is NOT recognized
# by the console even when added to the external-service whitelist; kept
# here so a future dev pass can re-test once/if that role is implemented.
RBAC_MANAGER_USER=rbac_test_manager
RBAC_MANAGER_PASS=""

# Moodle 'editingteacher' role @ system context — proxy probe for the
# console's stated "instructor" tier. Same NOT-YET-IMPLEMENTED status as above.
RBAC_TEACHER_USER=rbac_test_teacher
RBAC_TEACHER_PASS=""
# NOTE: quote password values in .env if they contain '#' — dotenv treats an unquoted # as a comment start.
